<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.6">
  <world name="nb_park_world">

    <!-- Core simulation plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- Physics engine settings (needed for PX4 SITL to run reliably) -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- Georeference: set to Nathan Benderson Park's real-world coordinates -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>27.377421</latitude_deg>
      <longitude_deg>-82.451841</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- Magnetic field vector required by the magnetometer plugin above.
         Without this, PX4 reports "Found 0 compass" even though the
         magnetometer-system plugin is loaded. -->
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <gravity>0 0 -9.8066</gravity>

    <!-- Fallback ground plane with collision. Keeps the drone from falling
         through if the nb_park model's terrain mesh has visual-only
         geometry and no collision. Adjust <pose> Z if your park's ground
         sits at a different height than 0. Remove this once nb_park's own
         collision geometry is confirmed to work. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2000 2000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <!-- Map model -->
    <include>
      <uri>model://nb_park</uri>
    </include>

    <!-- Default camera view -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>100 -1050 20 0 0.3 2.4</pose>
      </camera>
    </gui>


  </world>
</sdf>
